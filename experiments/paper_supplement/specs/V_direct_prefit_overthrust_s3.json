{
  "name": "V_direct_prefit_overthrust_s3",
  "experiment": {
    "experiment_name": "V_direct_prefit_overthrust_s3",
    "parameterization": "absolute",
    "seed": 3,
    "data": {
      "model_file": "overthrust_94x401_mps.csv",
      "model_units": "m/s",
      "csv_header": "none",
      "downsample": 1,
      "crop_shape": null,
      "grid_spacing_m": 20.0
    },
    "initialization": {
      "sigma": 15.0,
      "gaussian_mode": "reflect",
      "gaussian_truncate": 4.0
    },
    "model": {
      "neurons": [
        2,
        128,
        128,
        128,
        128,
        1
      ],
      "omega_0": 30.0,
      "mean_kmps": 3.0,
      "std_kmps": 1.0
    },
    "acquisition": {
      "num_shots": 10,
      "source_x_indices": [
        20,
        60,
        100,
        140,
        180,
        220,
        260,
        300,
        340,
        380
      ],
      "source_start_index": 20,
      "source_spacing_index": 40,
      "source_end_margin": 10,
      "source_depth_index": 1,
      "receiver_depth_index": 0,
      "receiver_stride": 1
    },
    "forward": {
      "dt_s": 0.002,
      "nt": 1500,
      "frequency_hz": 8.0,
      "npad": 15,
      "order": 2,
      "free_surface": true,
      "pml_reflection": 1e-06
    },
    "training": {
      "epochs": 4000,
      "learning_rate": 0.0001,
      "checkpoint_interval": 50,
      "shot_batch_size": 5
    }
  },
  "control": {
    "kind": "prefit_background",
    "updates": 5000,
    "learning_rate": 0.0001,
    "selection": "best_background_fit"
  },
  "robustness": {
    "condition": "overthrust_slowness",
    "noise_sigma": 0.0,
    "noise_seed": 3
  },
  "protocol": "paper_supplement_v1",
  "background": {
    "kind": "slowness_gaussian",
    "slowness_sigma_m": 135.0,
    "velocity_sigma_m": 187.5
  },
  "target": {
    "plateau": {
      "window": 300,
      "rel": 0.005
    }
  }
}
